# Per-laptop settings for the automation scripts, as plain KEY=value lines
# (read by lib.zsh and vault_notes.py). Copy to settings.env to change them;
# settings.env is not in git. Values left out keep the defaults below.

# The job planner: its folder under planner/ and its slash command
PLANNER=work
# Daily-note sections work-morning.sh fills, one daily-sources worker each
MORNING_SOURCES="linear helpscout slack"
